# ===== Backend =====
# OpenStates API token (https://open.pluralpolicy.com/accounts/profile/)
OPENSTATES_API_TOKEN=

# Base URL of the external API
OPENSTATES_API_URL=https://v3.openstates.org

# Backend port
PORT=3000

# Database URL (used when running outside Docker)
# In Docker the compose file builds this automatically from POSTGRES_* vars.
DATABASE_URL=postgresql://openstates:openstates@localhost:5432/openstates?schema=public

# Scheduled sync cron expression (UTC). Leave SYNC_JURISDICTION blank to disable.
# Must be the full OCD jurisdiction ID (e.g. ocd-jurisdiction/country:us/state:ga)
SYNC_CRON=0 0 * * *
SYNC_JURISDICTION=

# Allowed browser origin for CORS (dev only; production uses the nginx proxy)
CORS_ORIGIN=http://localhost:5173

# ===== PostgreSQL (used by Docker Compose) =====
POSTGRES_USER=openstates
POSTGRES_PASSWORD=openstates
POSTGRES_DB=openstates

# ===== Frontend =====
# Backend URL used by the Vite dev server proxy (relative /api is used in production)
VITE_API_URL=http://localhost:3000/api
